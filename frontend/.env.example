# Voicely Frontend Environment

# Backend API. Must include the /api/v1 prefix.
VITE_API_URL=http://localhost:5001/api/v1

# WebSocket base (no path). Used for the voice session and transcript sockets.
VITE_WS_URL=ws://localhost:5001

# Google OAuth client id. Must match GOOGLE_CLIENT_ID on the backend, which
# verifies every token against it.
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
