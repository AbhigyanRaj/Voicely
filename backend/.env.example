# -------------------------------------------------------------
# Voicely Backend Environment Variables Example
# Copy this file to .env and fill in your details to run locally
# -------------------------------------------------------------

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Required)
# A local or MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# JWT Configuration (Required)
# Used to sign session tokens for the dashboard.
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRE=7d

# Twilio Configuration (Required for Telephony)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# -------------------------------------------------------------
# AI Services (Add at least ONE LLM and ONE TTS)
# -------------------------------------------------------------

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# TTS Providers
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
SARVAM_API_KEY=your_sarvam_api_key
GOOGLE_TTS_API_KEY=your_google_tts_key

# Speech-to-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2-phonecall

# -------------------------------------------------------------
# Optional Integrations & Webhooks
# -------------------------------------------------------------

# Telegram Bot (Optional: For notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Webhook URLs
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# System Features
STREAMING_ENABLED=true

# Encryption Key for User Tokens (Required for Production)
# Must be exactly 64 char hex string. Used to encrypt provider API keys.
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
