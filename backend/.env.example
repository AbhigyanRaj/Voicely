# -------------------------------------------------------------
# Voicely Backend Environment
# Copy to .env and fill in. The stack is Deepgram STT + Groq LLM +
# Cartesia TTS, English only.
# -------------------------------------------------------------

# Server
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Database (required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Sessions (required)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRE=7d

# Encrypts stored provider credentials. Exactly 64 hex characters. (required)
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# -------------------------------------------------------------
# The voice pipeline. All three are required: a missing one fails
# at call time rather than at boot, so the server refuses to start.
# -------------------------------------------------------------

# Speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2-phonecall

# Conversational LLM
GROQ_API_KEY=your_groq_api_key

# Text-to-speech
CARTESIA_API_KEY=your_cartesia_api_key

# -------------------------------------------------------------
# Optional
# -------------------------------------------------------------

# Required for Google sign-in. Without it /auth/google refuses every
# request rather than trusting the client's claims.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Redis for the response cache. Falls back to an in-process cache.
REDIS_URL=redis://localhost:6379

# Public base URL, used to build absolute links.
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# Start generating a reply against interim transcripts, before the speaker has
# finished. Costs roughly 2.8x the LLM requests for about 145ms off p50.
SPECULATIVE_PREFILL=true
